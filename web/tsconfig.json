{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true, "skipLibCheck": true,
    "paths": {"@pnd/transport": ["./src/transport.ts"]}
  },
  "include": ["src/**/*.ts", "../demo/**/*.ts"]
}
