{
  "name": "pipapoen-node-descriptor",
  "private": true,
  "version": "26.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "check:locales": "node scripts/check-locales.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "build:demo": "node scripts/build-demo.mjs && tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.demo.config.ts",
    "test:demo": "node scripts/demo-test.mjs",
    "check:release": "python scripts/check-release.py"
  },
  "packageManager": "pnpm@11.28.13",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "9.1.0",
    "playwright": "^1.65.1",
    "postcss": "8.5.33",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "basecoat-css": "1.1.0"
  }
}
